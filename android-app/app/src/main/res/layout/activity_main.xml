<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="端侧隐私识别 · 云端深度诊断"
            android:textColor="#246BFD"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="知错图谱端云协同识题"
            android:textColor="#18212F"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#EAF1FF"
            android:padding="12dp"
            android:text="端侧识别：正在准备模型..."
            android:textColor="#17499D"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="14dp"
            android:background="#E9EDF3"
            android:contentDescription="错题图片预览"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPickImage"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="选择错题图片" />

            <Button
                android:id="@+id/btnRecognize"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="端侧提取文字" />
        </LinearLayout>

        <Button
            android:id="@+id/btnInterrupt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="中断端侧识别"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="等待确认"
            android:textColor="#18212F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="题目内容"
            android:textColor="#526074"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:gravity="top|start"
            android:hint="识别后请确认或修正题目"
            android:inputType="textMultiLine"
            android:minHeight="88dp"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvAnswerHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="学生作答候选 · 需要确认"
            android:textColor="#C65D45"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUserAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:gravity="top|start"
            android:hint="无法区分学生作答与红笔批改时请留空"
            android:inputType="textMultiLine"
            android:minHeight="70dp"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="批改与视觉线索"
            android:textColor="#526074"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etCorrectionNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:hint="红笔标注、圈画、教师批注或位置描述"
            android:inputType="textMultiLine"
            android:minHeight="60dp"
            android:padding="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="豆包分析接口"
            android:textColor="#526074"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etApiUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF"
            android:hint="https://你的后端域名/api/analyze-question"
            android:inputType="textUri"
            android:padding="12dp"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSaveOffline"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="离线保存" />

            <Button
                android:id="@+id/btnCloudAnalyze"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="确认并豆包分析" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="豆包分析结果"
            android:textColor="#18212F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCloudResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:minHeight="96dp"
            android:padding="12dp"
            android:text="尚未完成云端诊断"
            android:textColor="#526074"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="重新进行端侧识别" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="端侧原始输出（调试）"
            android:textColor="#526074"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvRawOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:minHeight="80dp"
            android:padding="12dp"
            android:textColor="#526074"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
